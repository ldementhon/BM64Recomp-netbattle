<rml>
	<head>
		<title>Launcher</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
            .online-panel { width: 1100dp; margin: 55dp auto; padding: 24dp; font-size: 27dp; }
            .online-panel h2 { font-size: 44dp; margin-bottom: 12dp; }
            .online-fields { display: flex; flex-direction: row; margin-top: 20dp; }
            .online-field { display: block; width: 320dp; flex-shrink: 0; margin-right: 24dp; }
            .online-field input, .online-field select { display: block; width: 100%; box-sizing: border-box; height: 48dp; padding: 6dp; background-color: #20242e; color: #ffffff; border: 2dp #6f7c92; }
            .online-field--port { width: 130dp; }
            .online-seats { margin-top: 22dp; margin-bottom: 18dp; }
            .online-seat { padding: 12dp; border-bottom: 1dp #667080; }
            .online-seat__ready { color: #45D043; }
            .online-seat__not-ready { color: #F86039; }
            /* Everyone is ready: make Start the obvious next step. */
            .online-panel .button.online-start--go { border-width: 4dp; border-color: #45D043; background-color: rgba(69, 208, 67, 0.25); color: #F2F2F2; }
            .online-panel .button.online-start--go:focus, .online-panel .button.online-start--go:hover { background-color: rgba(69, 208, 67, 0.45); }
            .online-status { min-height: 42dp; margin-top: 16dp; }
            .online-panel .button { display: inline-block; margin: 12dp 14dp 0 0; padding: 12dp 22dp; }
            .online-note { font-size: 23dp; color: #bfc7d4; margin-top: 10dp; }
		</style>
	</head>
	<body>
		<div id="window" data-model="launcher_model">
			<div class="launcher" data-if="!online_visible">
				<div class="launcher__vertical-split">
					<div class="launcher__title-quadrant">
						<button class="subtitle-title" enabled>
							<div><h3>Bomberman 64: Recompiled</h3></div>
						</button>
					</div>
					<div class="launcher__content-quadrant"></div>
				</div>
				<div class="launcher__vertical-split launcher__vertical-split--right">
					<div class="launcher__background-wrapper">
						<svg src="BM64Recomp.svg" class="launcher__background-mm" />
					</div>
					<div class="launcher__title-quadrant launcher__title-quadrant--right">
						<button class="subtitle-title subtitle-title--right" selected>
						</button>
					</div>
					<div class="launcher__content-quadrant">
						<button data-if="!mm_rom_valid" onclick="select_rom" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Select ROM</div>
						</button>
						<button data-if="mm_rom_valid" onclick="start_game" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<button onclick="open_controls" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Setup controls</div>
						</button>
                        <button data-if="mm_rom_valid &amp;&amp; online_available" data-event-click="online_action('open')" class="menu-list-item menu-list-item--right">
                            <div class="menu-list-item__bullet">•</div>
                            <div class="menu-list-item__label">Online Battle</div>
                        </button>
						<button onclick="open_settings" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Settings</div>
						</button>
						<button onclick="open_mods" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Mods</div>
						</button>
						<button onclick="exit_game" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Exit</div>
						</button>
					</div>
				</div>
				<div class="bottom-left">
					<label>v{{version_number}} · {{online_release}}</label>
				</div>
			</div>
            <div class="online-panel" data-if="online_visible">
                <h2>Online Battle</h2>
                <p>Fixed player colors. P1 advances the shared menus. Empty seats use CPUs.</p>
                <p class="online-note">{{online_release}} early playtest: audio enabled; rumble disabled. P1 chooses stages. With pausing on, anyone's Start pauses and resumes. Leave ends play for everyone.</p>
                <div class="online-fields">
                    <label class="online-field">Server address
                        <input id="online-address" type="text" data-value="online_address" maxlength="253" data-attrif-disabled="online_connected"/>
                    </label>
                    <label class="online-field online-field--port">Port
                        <input id="online-server-port" type="text" data-value="online_server_port" maxlength="5" data-attrif-disabled="online_connected"/>
                    </label>
                    <label class="online-field">Your name
                        <input id="online-name" type="text" data-value="online_name" maxlength="32"/>
                    </label>
                </div>
                <div class="online-fields">
                    <label class="online-field">Use local controls for
                        <select id="online-local-port" data-value="online_port" data-attrif-disabled="online_ready || online_in_match">
                            <option value="0">Local player 1</option><option value="1">Local player 2</option>
                            <option value="2">Local player 3</option><option value="3">Local player 4</option>
                        </select>
                    </label>
                    <button class="button" onclick="open_controls" data-attrif-disabled="online_ready || online_in_match">Setup controls</button>
                </div>
                <div class="online-seats">
                    <div class="online-seat">{{online_seat0}}<span class="online-seat__ready" data-if="online_seat0_state == 2"> · Ready</span><span class="online-seat__not-ready" data-if="online_seat0_state == 1"> · Not ready</span></div>
                    <div class="online-seat">{{online_seat1}}<span class="online-seat__ready" data-if="online_seat1_state == 2"> · Ready</span><span class="online-seat__not-ready" data-if="online_seat1_state == 1"> · Not ready</span></div>
                    <div class="online-seat">{{online_seat2}}<span class="online-seat__ready" data-if="online_seat2_state == 2"> · Ready</span><span class="online-seat__not-ready" data-if="online_seat2_state == 1"> · Not ready</span></div>
                    <div class="online-seat">{{online_seat3}}<span class="online-seat__ready" data-if="online_seat3_state == 2"> · Ready</span><span class="online-seat__not-ready" data-if="online_seat3_state == 1"> · Not ready</span></div>
                </div>
                <div class="online-status">{{online_status}}</div>
                <div class="online-note">{{online_latency}}</div>
                <button id="online-connect" class="button" data-if="!online_connected" data-event-click="online_action('connect')">Connect</button>
                <button id="online-ready" class="button" data-if="online_joined &amp;&amp; !online_in_match &amp;&amp; !online_ready" data-event-click="online_action('ready')">Ready</button>
                <button class="button" data-if="online_joined &amp;&amp; !online_in_match &amp;&amp; online_ready" data-event-click="online_action('ready')">Not ready</button>
                <button id="online-pausing" class="button" data-if="online_joined &amp;&amp; !online_in_match" data-attrif-disabled="!online_can_change_rules" data-event-click="online_action('pausing')">Pausing: {{online_pausing ? 'On' : 'Off'}} (P1)</button>
                <button id="online-start" class="button" data-if="online_joined &amp;&amp; !online_in_match" data-attrif-disabled="!online_can_start" data-class-online-start--go="online_can_start" data-event-click="online_action('start')">Start battle (P1)</button>
                <button class="button" data-if="online_in_match" data-event-click="online_action('cancel')">Cancel battle</button>
                <button id="online-leave" class="button" data-if="online_connected" data-event-click="online_action('leave')">Leave</button>
                <button class="button" data-event-click="online_action('back')">Back</button>
            </div>
        </div>
	</body>
</rml>
