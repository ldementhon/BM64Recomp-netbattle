--- /dev/null
+++ b/src/common/rt64_rollback_probe.h
@@ -0,0 +1,81 @@
+#pragma once
+// Diagnostic counters; callbacks are installed before renderer threads start.
+#include <atomic>
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstddef>
+#include <mutex>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#ifdef __APPLE__
+#include <mach/mach_time.h>
+#endif
+namespace RT64::RollbackProbe {
+inline std::atomic<bool> enabled{false};
+inline bool incremental_writeback=false, inline_uploads=false, shared_uploads=false, lazy_dither=false;
+inline std::atomic<uint64_t> native_noise_pixels{}, native_other_pixels{};
+inline std::atomic<uint64_t> shared_upload_bytes{}, shared_upload_copies{};
+inline std::atomic<uint64_t> inline_upload_calls{};
+inline bool aligned_pacing=false, bounded_present=false;
+inline std::atomic<uint64_t> latest_submitted{}, retired_presents{}, slot_wait_ns{}, maximum_in_flight{};
+inline std::mutex display_mutex;
+inline std::condition_variable display_condition;
+inline unsigned in_flight=0;
+inline std::atomic<uint64_t> refresh_period_ns{16666667};
+inline std::atomic<bool> recovering_display{false};
+inline uint64_t last_observed_display=0;
+inline unsigned fresh_displays=0;
+inline void observeDisplay(uint64_t deadline, uint64_t time) {
+    if(!bounded_present || !deadline || !time) return;
+    std::lock_guard lock(display_mutex);
+    if(time<=last_observed_display) return;
+    last_observed_display=time;
+    if(time>deadline+refresh_period_ns+1000000) {
+        recovering_display=true; fresh_displays=0;
+    } else if(++fresh_displays>=2) {
+        recovering_display=false; fresh_displays=2;
+    }
+}
+inline std::atomic<uint64_t> present_hitch_frame{0};
+inline std::atomic<unsigned> present_hitch_ms{0};
+inline void waitDisplaySlot() {
+    std::unique_lock lock(display_mutex);
+    if (!display_condition.wait_for(lock, std::chrono::seconds(2), [] { return in_flight<2; })) {
+        fprintf(stderr,"CHECKPOINT FAIL: bounded presentation callback timeout\n"); std::abort();
+    }
+}
+inline void submittedDisplay() {
+    std::lock_guard lock(display_mutex);
+    if(++in_flight>2) { fprintf(stderr,"CHECKPOINT FAIL: drawable bound exceeded\n"); std::abort(); }
+    maximum_in_flight=std::max(maximum_in_flight.load(),uint64_t(in_flight));
+}
+inline void completedDisplay() {
+    { std::lock_guard lock(display_mutex); if(in_flight) --in_flight; }
+    display_condition.notify_all();
+}
+inline std::atomic<uint64_t> native_upload_wait{}, native_texture_wait{}, native_submit{}, native_fence_wait{};
+inline std::atomic<uint64_t> native_gpu{}, native_schedule{}, native_complete_delay{}, native_wakeup{}, native_samples{}, native_invalid{};
+inline std::atomic<uint64_t> native_last_completion{};
+inline std::atomic<uint64_t> stored_bytes{};
+inline uint64_t now() {
+#ifdef __APPLE__
+    static const auto scale = [] { mach_timebase_info_data_t t; mach_timebase_info(&t); return double(t.numer)/t.denom; }();
+    return uint64_t(mach_absolute_time()*scale);
+#else
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+#endif
+}
+inline std::atomic<uint64_t> graphics{}, native{}, native_wait{}, copy{}, copy_bytes{}, screen{}, acquire{}, present_gpu_wait{}, pacing{}, present_wait{}, present_call{}, workload_dependency{};
+inline void (*texture_read)(const void*, size_t, unsigned) = nullptr;
+inline void (*writeback)(void*, size_t, bool) = nullptr;
+inline void (*displayed)(uint64_t, uint64_t, uint64_t) = nullptr;
+inline uint64_t frame = 0, deadline = 0; // Graphics-thread only; copied into queued Presents.
+struct Timer {
+    std::atomic<uint64_t>& counter;
+    uint64_t start;
+    explicit Timer(std::atomic<uint64_t>& c) : counter(c), start(enabled ? now() : 0) {}
+    ~Timer() { if (start) counter += now()-start; }
+};
+}
