+    void capture(uint8_t* source, size_t size, bool full_copy = false) {
+        auto start=std::chrono::steady_clock::now();
+        clear(); size_ = size;
+        auto cleared=std::chrono::steady_clock::now();
+        clear_ms=std::chrono::duration<double,std::milli>(cleared-start).count(); remap_ms=0;
+#ifdef __APPLE__
+        if (!full_copy) {
+            vm_prot_t current, maximum;
+            checked(mach_vm_remap(mach_task_self(), &image_, size_, 0, VM_FLAGS_ANYWHERE,
+                mach_task_self(), reinterpret_cast<mach_vm_address_t>(source), true,
+                &current, &maximum, VM_INHERIT_NONE));
+            remap_ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-cleared).count();
+            return;
+        }
+#endif
+        copy_.assign(source, source + size_);
+    }
+    void restore(uint8_t* target) const {
+        auto start=std::chrono::steady_clock::now(); clear_ms=remap_ms=0;
+#ifdef __APPLE__
+        if (image_) {
+            auto address = reinterpret_cast<mach_vm_address_t>(target);
+            vm_prot_t current, maximum;
+            checked(mach_vm_remap(mach_task_self(), &address, size_, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE,
+                mach_task_self(), image_, true, &current, &maximum, VM_INHERIT_NONE));
+            remap_ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+            return;
+        }
+#endif
+        std::memcpy(target, copy_.data(), size_);
+    }
+    size_t copied_bytes() const { return copy_.size(); }
+};
diff --git a/src/game/checkpoint_stack.hpp b/src/game/checkpoint_stack.hpp
new file mode 100644
index 0000000..0c09885
--- /dev/null
+++ b/src/game/checkpoint_stack.hpp
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstdint>
+#include <algorithm>
+#include <vector>
+#include <memory>
+#include <cstring>
+
+// Include after minicoro's implementation. Preserve the header/storage and live
+// stack tail, including a conservative 256-byte ABI red zone below saved SP.
+struct CheckpointStack {
+    std::shared_ptr<void> owner; // Production snapshots keep their allocation alive.
+    mco_coro* address = nullptr;
+    size_t allocation_size = 0, tail_offset = 0;
+    std::vector<uint8_t> prefix, tail;
+    void capture(mco_coro* co, bool full_copy = false) {
+        address = co; allocation_size = co->coro_size;
+        auto start = reinterpret_cast<uintptr_t>(co);
+        auto low = reinterpret_cast<uintptr_t>(co->stack_base);
+        auto high = low + co->stack_size;
+        uintptr_t sp = 0;
+#if defined(__aarch64__) && defined(MCO_USE_ASM)
+        sp = reinterpret_cast<uintptr_t>(static_cast<_mco_context*>(co->context)->ctx.sp);
+#endif
+        // An OS continuation can be suspended on a nested Hudson stack. In that
+        // case retain its whole outer stack; its saved SP does not bound it.
+        if (full_copy || sp < low || sp > high || low < start || high > start + allocation_size) {
+            prefix.assign(reinterpret_cast<uint8_t*>(co), reinterpret_cast<uint8_t*>(co) + allocation_size);
+            tail.clear(); tail_offset = allocation_size;
+        } else {
+            auto tail_start = std::max(low, sp - std::min<uintptr_t>(sp, 256));
+            tail_offset = tail_start - start;
+            prefix.assign(reinterpret_cast<uint8_t*>(co), reinterpret_cast<uint8_t*>(low));
+            tail.assign(reinterpret_cast<uint8_t*>(tail_start), reinterpret_cast<uint8_t*>(start + allocation_size));
+        }
+    }
+    void restore() const {
+        std::memcpy(address, prefix.data(), prefix.size());
+        if (!tail.empty()) std::memcpy(reinterpret_cast<uint8_t*>(address) + tail_offset, tail.data(), tail.size());
+    }
+    size_t bytes() const { return prefix.size() + tail.size(); }
+};
diff --git a/src/game/checkpoint_trace.hpp b/src/game/checkpoint_trace.hpp
new file mode 100644
index 0000000..a6eda86
--- /dev/null
+++ b/src/game/checkpoint_trace.hpp
@@ -0,0 +1,44 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <ctime>
+#include <sys/resource.h>
+
+// Wall time locates the slow stage; thread CPU and task-wide scheduler/fault
+// deltas distinguish computation from blocking without claiming a kernel cause.
+struct CheckpointTrace {
+    using Clock=std::chrono::steady_clock;
+    struct Stage { const char* name; double wall, cpu; };
+    bool enabled;
+    const char* operation;
+    uint64_t frame;
+    size_t slot;
+    Clock::time_point start, previous;
+    double cpu_start, cpu_previous;
+    rusage usage{};
+    std::array<Stage,8> stages{};
+    size_t count=0;
+    static double cpu_ms() {
+        timespec t{}; clock_gettime(CLOCK_THREAD_CPUTIME_ID,&t);
+        return t.tv_sec*1000.0+t.tv_nsec/1e6;
+    }
+    CheckpointTrace(bool enabled,const char* operation,uint64_t frame,size_t slot):enabled(enabled),operation(operation),frame(frame),slot(slot) {
+        if(enabled) { getrusage(RUSAGE_SELF,&usage); start=previous=Clock::now(); cpu_start=cpu_previous=cpu_ms(); }
+    }
+    void mark(const char* name) {
+        if(!enabled) return;
+        auto now=Clock::now(); auto cpu=cpu_ms();
+        stages[count++]={name,std::chrono::duration<double,std::milli>(now-previous).count(),cpu-cpu_previous};
+        previous=now; cpu_previous=cpu;
+    }
+    void report(double clear_ms,double remap_ms,size_t bytes) const {
+        if(!enabled) return;
+        double total=std::chrono::duration<double,std::milli>(previous-start).count();
+        if(total<2.0) return;
+        rusage after{}; getrusage(RUSAGE_SELF,&after);
+        fprintf(stderr,"CHECKPOINT_SLOW: operation=%s frame=%llu slot=%zu wall_ms=%.3f thread_cpu_ms=%.3f vm_clear_ms=%.3f vm_map_ms=%.3f native_bytes=%zu minor_faults=%ld major_faults=%ld voluntary_switches=%ld involuntary_switches=%ld",operation,frame,slot,total,cpu_previous-cpu_start,clear_ms,remap_ms,bytes,after.ru_minflt-usage.ru_minflt,after.ru_majflt-usage.ru_majflt,after.ru_nvcsw-usage.ru_nvcsw,after.ru_nivcsw-usage.ru_nivcsw);
+        for(size_t i=0;i<count;++i) fprintf(stderr," %s_wall_ms=%.3f %s_cpu_ms=%.3f",stages[i].name,stages[i].wall,stages[i].name,stages[i].cpu);
+        fputc('\n',stderr);
+    }
+};
diff --git a/src/game/framebuffer_trace.inc b/src/game/framebuffer_trace.inc
new file mode 100644
index 0000000..b4d964b
--- /dev/null
+++ b/src/game/framebuffer_trace.inc
@@ -0,0 +1,67 @@
+// Included inside checkpoint. This observer is not part of snapshot state.
+#ifdef BM64_TRACE_MEMORY
+extern "C" uint32_t bm64_trace_canary(void*);
+static uint8_t* traced_ram;
+static uint64_t trace_report_at;
+static std::map<std::tuple<uint32_t,size_t,int,unsigned>,uint64_t> texture_reads;
+static std::vector<uint8_t> pixel_owner;
+struct TraceRead { uint64_t count=0; uint32_t address=0; uint64_t first_frame=0; };
+static std::map<std::pair<uintptr_t,int>,TraceRead> trace_reads;
+static std::map<std::tuple<uint32_t,size_t,bool>,uint64_t> trace_writes;
+void framebuffer_written(void* pointer, size_t count, bool depth) {
+    if (!traced_ram) return;
+    size_t offset = static_cast<uint8_t*>(pointer)-traced_ram;
+    require(offset+count <= pixel_owner.size(), "framebuffer trace outside RAM");
+    std::fill_n(pixel_owner.begin()+offset,count,depth ? 2 : 1);
+    if(frame>=trace_report_at) ++trace_writes[{uint32_t(offset),count,depth}];
+}
+void framebuffer_texture_read(const void* pointer, size_t count, unsigned kind) {
+    uintptr_t address=reinterpret_cast<uintptr_t>(pointer),base=reinterpret_cast<uintptr_t>(traced_ram);
+    if(!base || frame<trace_report_at || address<base || address-base+count>pixel_owner.size()) return;
+    int owners=0; for(size_t i=0;i<count;++i) owners |= pixel_owner[address-base+i];
+    if(owners) ++texture_reads[{uint32_t(address-base),count,owners,kind}];
+}
+static void trace_access(void* pointer, size_t count, bool store, void* pc) {
+    uintptr_t address = reinterpret_cast<uintptr_t>(pointer), base = reinterpret_cast<uintptr_t>(traced_ram);
+    if (!base || address < base || address-base+count > pixel_owner.size()) return;
+    size_t offset=address-base;
+    int owners=0;
+    for (size_t i=0;i<count;++i) { owners |= pixel_owner[offset+i]; if (store) pixel_owner[offset+i]=0; }
+    if (!store && owners && frame>=trace_report_at) {
+        auto& hit=trace_reads[{reinterpret_cast<uintptr_t>(pc),owners}];
+        if (!hit.count) { hit.address=offset; hit.first_frame=frame; }
+        ++hit.count;
+    }
+}
+#endif
+static bool trace_frame(unsigned at) {
+    unsigned count=setting("BM64_TRACE_FRAMES",0);
+    if (!count) return false;
+#ifdef BM64_TRACE_MEMORY
+    if (frame == 1) {
+        pixel_owner.resize(recomp::mem_size); traced_ram=ram;
+        std::fill_n(pixel_owner.end()-4096,4,1);
+        framebuffer_texture_read(ram+recomp::mem_size-4096,4,99);
+        require(texture_reads.size()==1,"texture observer canary failed");
+        bm64_trace_canary(ram+recomp::mem_size-4096);
+        require(trace_reads.size()==1 && trace_reads.begin()->second.count==1,"instrumented load/store canary failed");
+        framebuffer_texture_read(ram+recomp::mem_size-4096,4,99);
+        require(texture_reads.begin()->second==1,"CPU overwrite did not clear texture ownership");
+        trace_reads.clear(); texture_reads.clear(); trace_report_at=at;
+        fprintf(stderr,"PASS: instrumented read observed; CPU overwrite cleared framebuffer ownership\n");
+    }
+    if (frame == at+count) {
+        traced_ram=nullptr;
+        for (const auto& [key,n]:trace_writes) fprintf(stderr,"FBWRITE: address=%08x bytes=%zu depth=%d count=%llu\n",std::get<0>(key),std::get<1>(key),std::get<2>(key),n);
+        for(const auto& [key,n]:texture_reads) fprintf(stderr,"FBTEXTURE: address=%08x bytes=%zu owner=%d command=%u count=%llu\n",std::get<0>(key),std::get<1>(key),std::get<2>(key),std::get<3>(key),n);
+        for (const auto& [key,hit]:trace_reads) {
+            Dl_info info{}; dladdr(reinterpret_cast<void*>(key.first),&info);
+            fprintf(stderr,"FBREAD: owner=%d first_address=%08x first_frame=%llu reads=%llu function=%s offset=%zu\n",key.second,hit.address,hit.first_frame,hit.count,info.dli_sname ? info.dli_sname : "unknown",key.first-reinterpret_cast<uintptr_t>(info.dli_saddr));
+        }
+        fprintf(stderr,"PASS: framebuffer read trace completed %u updates (%zu read sites, %zu write regions)\n",count,trace_reads.size(),trace_writes.size()); fflush(stderr); std::_Exit(0);
+    }
+    return true;
+#else
+    require(false,"framebuffer read tracing requires BM64_TRACE_MEMORY build"); return true;
+#endif
+}
diff --git a/src/game/rollback_profile.inc b/src/game/rollback_profile.inc
new file mode 100644
index 0000000..6ad2f6a
--- /dev/null
+++ b/src/game/rollback_profile.inc
@@ -0,0 +1,69 @@
+namespace Probe = RT64::RollbackProbe;
+struct Profile {
+    uint64_t graphics_wait, graphics, native, native_wait, copy, bytes, stored, screen, acquire, present_gpu_wait, pacing, present_wait, present_call, dependency;
+    uint64_t upload, texture, submit, fence, gpu, schedule, completion, wakeup, samples, invalid, noise_pixels, other_pixels;
+    std::array<uint64_t,Probe::PrepCount> prep_wall{},prep_cpu{},prep_calls{};
+};
+static Profile profile() {
+    Profile p{graphics_wait_ns,Probe::graphics,Probe::native,Probe::native_wait,Probe::copy,Probe::copy_bytes,Probe::stored_bytes,Probe::screen,Probe::acquire,Probe::present_gpu_wait,Probe::pacing,Probe::present_wait,Probe::present_call,Probe::workload_dependency, Probe::native_upload_wait, Probe::native_texture_wait, Probe::native_submit, Probe::native_fence_wait, Probe::native_gpu, Probe::native_schedule, Probe::native_complete_delay, Probe::native_wakeup, Probe::native_samples, Probe::native_invalid, Probe::native_noise_pixels, Probe::native_other_pixels};
+    for(unsigned i=0;i<Probe::PrepCount;++i) { p.prep_wall[i]=Probe::prep_wall[i]; p.prep_cpu[i]=Probe::prep_cpu[i]; p.prep_calls[i]=Probe::prep_calls[i]; }
+    return p;
+}
+static void profile_report(const Profile& a, const Profile& b, unsigned updates) {
+    fprintf(stderr,"PROFILE: updates=%u graphics_fence_ms=%.3f graphics_worker_ms=%.3f native_stage_ms=%.3f native_gpu_upload_wait_ms=%.3f RAM_copy_ms=%.3f RAM_copy_bytes=%llu RAM_stored_bytes=%llu screen_ms=%.3f acquire_ms=%.3f present_gpu_wait_ms=%.3f pacing_ms=%.3f swapchain_wait_ms=%.3f present_call_ms=%.3f present_dependency_ms=%.3f\n",updates,
+        (b.graphics_wait-a.graphics_wait)/1e6,(b.graphics-a.graphics)/1e6,(b.native-a.native)/1e6,(b.native_wait-a.native_wait)/1e6,(b.copy-a.copy)/1e6,b.bytes-a.bytes,b.stored-a.stored,(b.screen-a.screen)/1e6,(b.acquire-a.acquire)/1e6,(b.present_gpu_wait-a.present_gpu_wait)/1e6,(b.pacing-a.pacing)/1e6,(b.present_wait-a.present_wait)/1e6,(b.present_call-a.present_call)/1e6,(b.dependency-a.dependency)/1e6);
+    fprintf(stderr,"NATIVE_PROFILE: updates=%u samples=%llu invalid=%llu noise_pixels=%llu other_pixels=%llu CPU_upload_wait_ms=%.3f texture_wait_ms=%.3f submit_ms=%.3f fence_wait_ms=%.3f GPU_execute_ms=%.3f submit_to_GPU_ms=%.3f GPU_to_callback_ms=%.3f callback_to_wake_ms=%.3f\n",updates,b.samples-a.samples,b.invalid-a.invalid,b.noise_pixels-a.noise_pixels,b.other_pixels-a.other_pixels,(b.upload-a.upload)/1e6,(b.texture-a.texture)/1e6,(b.submit-a.submit)/1e6,(b.fence-a.fence)/1e6,(b.gpu-a.gpu)/1e6,(b.schedule-a.schedule)/1e6,(b.completion-a.completion)/1e6,(b.wakeup-a.wakeup)/1e6);
+    if(Probe::prep_profile) {
+        fprintf(stderr,"PREP_PROFILE: updates=%u",updates);
+        for(unsigned i=0;i<Probe::PrepCount;++i) fprintf(stderr," %s_wall_ms=%.3f %s_CPU_ms=%.3f %s_calls=%llu",Probe::prep_names[i],(b.prep_wall[i]-a.prep_wall[i])/1e6,Probe::prep_names[i],(b.prep_cpu[i]-a.prep_cpu[i])/1e6,Probe::prep_names[i],b.prep_calls[i]-a.prep_calls[i]);
+        fprintf(stderr,"\n");
+    }
+
+}
+struct Presentation { uint64_t frame, deadline, time, callback; };
+static std::mutex presentation_mutex;
+static std::vector<Presentation> presentations;
+static std::vector<Probe::PresentTrace> present_traces;
+static void present_trace(const Probe::PresentTrace& trace) {
+    std::lock_guard lock(presentation_mutex);
+    present_traces.push_back(trace);
+}
+void displayed(uint64_t id, uint64_t deadline, uint64_t time) {
+    const auto callback=Probe::now();
+    std::lock_guard lock(presentation_mutex);
+    presentations.push_back({id,deadline,time,callback});
+    if(id) Probe::observeDisplay(deadline,time);
+}
+
+static void loop_wait_until(uint64_t deadline) {
+    if(!Probe::aligned_pacing) {
+        auto now=Probe::now();
+        if(now<deadline) std::this_thread::sleep_for(std::chrono::nanoseconds(deadline-now));
+        return;
+    }
+#ifdef __APPLE__
+    static const auto scale=[] { mach_timebase_info_data_t t; mach_timebase_info(&t); return double(t.denom)/t.numer; }();
+    constexpr uint64_t spin_ns=1500000;
+    if(Probe::now()+spin_ns<deadline) mach_wait_until(uint64_t((deadline-spin_ns)*scale));
+#endif
+    while(Probe::now()<deadline) std::atomic_signal_fence(std::memory_order_seq_cst);
+}
+static uint64_t display_aligned_epoch(uint64_t& period) {
+    std::vector<uint64_t> gaps;
+    uint64_t last=0;
+    { std::lock_guard lock(presentation_mutex);
+      for(auto p:presentations) if(p.time>last) {
+          if(last && p.time-last>12000000 && p.time-last<20000000) gaps.push_back(p.time-last);
+          last=p.time;
+      }
+    }
+    require(gaps.size()>=10,"not enough display samples to align pacing");
+    if(gaps.size()>60) gaps.erase(gaps.begin(),gaps.end()-60);
+    std::sort(gaps.begin(),gaps.end()); period=gaps[gaps.size()/2];
+    auto now=Probe::now();
+    // Diagnostic phase sweep; latency is always measured from this actual release.
+    const char* value=std::getenv("BM64_RELEASE_LEAD_US");
+    auto lead=value ? std::stoll(value)*1000 : 0;
+    require(lead<int64_t(period) && lead>-int64_t(period),"release phase must be within one refresh");
+    return int64_t(last+((now-last)/period+2)*period)-lead;
+}
diff --git a/src/game/running_loop.inc b/src/game/running_loop.inc
new file mode 100644
index 0000000..a83d866
--- /dev/null
+++ b/src/game/running_loop.inc
@@ -0,0 +1,227 @@
+// A deterministic delayed-input fixture, paced at 60 Hz without per-frame GPU drains.
+static unsigned loop_length, loop_buffer;
+static uint64_t loop_at, loop_frontier;
+static bool loop_oracle, loop_verifying;
+static constexpr unsigned loop_warmup=120, loop_lead=17;
+static unsigned loop_spacing=60;
+struct LoopCycle { unsigned index; uint64_t release,wake,execute,finish; double capture,restore; bool rollback, hidden; };
+static uint64_t pending_begin(uint64_t f) {
+    uint64_t first=loop_at+loop_warmup+loop_lead;
+    if (f<first || !loop_length) return 0;
+    uint64_t start=first+(f-first)/loop_spacing*loop_spacing;
+    return f<start+loop_length ? start : 0;
+}
+static uint64_t input_frame(int controller) {
+    if (!loop_at || frame<loop_at) return frame;
+    auto sample=frame-loop_buffer;
+    if (controller==1 && !loop_oracle && !replay_pass) {
+        auto begin=pending_begin(frame);
+        if (begin) sample=begin-loop_buffer-1; // Hold the last received remote input.
+    }
+    return sample;
+}
+static bool running_loop(unsigned at) {
+    const unsigned count=setting("BM64_LOOP_FRAMES",0);
+    if (!count) return false;
+    require(count>loop_warmup && at>16,"running loop needs warmup and a checkpoint frame");
+    static uint64_t period=1000000000ull/60;
+    static uint64_t epoch, cycle_start, cycle_release, execution_start;
+    static double checkpoint_ms, restore_ms;
+    static uint64_t gfx_before;
+    static unsigned rollbacks, prediction_divergences, source_retired;
+    static bool normal_hidden=false;
+    static Profile before, cycle_profile;
+    static std::vector<double> all, rollback_times, normal_times, checkpoint_times, simulation_times;
+    static std::vector<LoopCycle> cycle_log;
+    static std::vector<double> cpu_lateness;
+    static std::map<uint64_t,Digest> oracle;
+    static std::ofstream oracle_output;
+    static bool started=false;
+    if (!loop_at) {
+        if(std::getenv("BM64_PRESENT_TRACE")) Probe::present_trace=present_trace;
+        loop_at=at;
+        loop_buffer=setting("BM64_INPUT_BUFFER",2);
+        loop_length=setting("BM64_ROLLBACK_LENGTH",4);
+        loop_spacing=setting("BM64_ROLLBACK_SPACING",60);
+        require(loop_spacing>=loop_length+4,"rollback spacing too small");
+#ifdef __APPLE__
+        if(Probe::aligned_pacing) pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE,0);
+#endif
+        loop_oracle=std::getenv("BM64_LOOP_ORACLE")!=nullptr;
+        loop_verifying=std::getenv("BM64_LOOP_VERIFY")!=nullptr;
+        require(loop_buffer<=4 && (loop_length==0 || loop_length==4 || loop_length==8 || loop_length==12),"invalid rollback/input buffer length");
+        require(!std::getenv("BM64_CATCHUP_FRAMES") && !std::getenv("BM64_SUPPRESS_REPLAY") && !std::getenv("BM64_BENCHMARK_FRAMES"),"conflicting loop modes");
+        if (loop_verifying) loop_oracle=true; // Raw contexts contain native f_odd pointers; compare within this process.
+        if (std::getenv("BM64_LOOP_ORACLE")) {
+            const char* path=std::getenv("BM64_ORACLE_PATH"); require(path,"oracle path missing");
+            oracle_output.open(path); require(oracle_output.good(),"oracle output");
+        }
+    }
+    if (frame<at) return true;
+    if (!started) {
+        if(loop_oracle && loop_verifying) save(0,true);
+        // Navigation ran unpaced. Clear that setup backlog once, before warmup.
+        finish_presentation();
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        epoch=Probe::now();
+        if(!loop_oracle && !loop_verifying) loop_wait_until(epoch);
+        cycle_release=epoch; cycle_start=execution_start=Probe::now(); loop_frontier=frame; before=profile();
+        fprintf(stderr,"LOOP_CLOCK: epoch_ns=%llu period_ns=%llu aligned=%d bounded=%d spacing=%u\n",epoch,period,Probe::aligned_pacing,Probe::bounded_present,loop_spacing);
+        checkpoint_ms=save(1+frame%16,true); restore_ms=0; gfx_before=graphics_wait_ns; cycle_profile=profile();
+        presentation_frame=loop_oracle ? 0 : 1; presentation_deadline=epoch+period; started=true;
+        return true;
+    }
+    checkpoint_ms+=save(1+frame%16,true);
+    if (loop_oracle || loop_verifying) {
+        auto actual=digest();
+        if (loop_oracle) {
+            oracle[frame]=actual;
+            if(oracle_output.is_open()) oracle_output<<std::dec<<frame<<' '<<std::hex<<actual.ram<<' '<<actual.registers<<'\n';
+        }
+        else if (!replay_pass && pending_begin(frame-1)) {
+            if(!pending_begin(frame)) {
+                require(oracle.count(frame),"missing prediction-end oracle");
+                auto expected=oracle.at(frame);
+                prediction_divergences += actual.ram!=expected.ram || actual.registers!=expected.registers;
+            }
+        }
+        else {
+            require(oracle.count(frame),"missing oracle frame");
+            auto expected=oracle.at(frame);
+            if (actual.ram!=expected.ram || actual.registers!=expected.registers) {
+                fprintf(stderr,"CHECKPOINT FAIL: loop frame=%llu replay=%u RAM=%016llx/%016llx registers=%016llx/%016llx\n",frame,replay_pass,expected.ram,actual.ram,expected.registers,actual.registers);
+                if (std::getenv("BM64_NEGATIVE_INPUT")) { fprintf(stderr,"PASS: negative control detected divergence\n"); fflush(stderr); std::_Exit(0); }
+                std::_Exit(2);
+            }
+        }
+    }
+    if (replay_pass) {
+        if (frame<loop_frontier) return true;
+        replay_pass=0;
+        normal_hidden=Probe::bounded_present && Probe::now()>presentation_deadline;
+        suppress_render=normal_hidden;
+        // The new normal update is the sole presented update in this display cycle.
+        return true;
+    }
+    uint64_t finish=Probe::now();
+    unsigned index=frame-at-1;
+    cycle_log.push_back({index,cycle_release,cycle_start,execution_start,finish,checkpoint_ms,restore_ms,bool(catchup_active),normal_hidden});
+    source_retired+=normal_hidden;
+    if (index>=loop_warmup) {
+        double total=(finish-cycle_start)/1e6;
+        all.push_back(total); checkpoint_times.push_back(checkpoint_ms);
+        simulation_times.push_back(total-(graphics_wait_ns.load()-gfx_before)/1e6-checkpoint_ms-restore_ms);
+        bool corrected=catchup_active;
+        if(corrected && profiling) {
+            fprintf(stderr,"LOOP_ROLLBACK: index=%u updates=%u total_ms=%.3f capture_ms=%.3f restore_ms=%.3f\n",index,loop_length+1,total,checkpoint_ms,restore_ms);
+            profile_report(cycle_profile,profile(),loop_length+1);
+        }
+        (corrected ? rollback_times : normal_times).push_back(total);
+        double late=std::max(0.0,(double(finish)-double(epoch+(index+1)*period))/1e6);
+        cpu_lateness.push_back(late);
+    }
+    catchup_active=false;
+    // Calibrate once from paced warmup displays, then freeze phase and period.
+    if(index+1==loop_warmup/2 && Probe::aligned_pacing && !loop_oracle && !loop_verifying) {
+        epoch=display_aligned_epoch(period)-(index+1)*period;
+        Probe::refresh_period_ns=period;
+        fprintf(stderr,"LOOP_CLOCK: epoch_ns=%llu period_ns=%llu aligned=1 bounded=%d spacing=%u\n",epoch,period,Probe::bounded_present,loop_spacing);
+    }
+    if(index+1==loop_warmup) before=profile();
+    if (frame==at+count) {
+        presentation_frame=0;
+        finish_presentation(); // Cleanup only; outside every timed display cycle.
+        if (loop_oracle) {
+            if(oracle_output.is_open()) oracle_output.close();
+            if(loop_verifying) {
+                restore(0,true); loop_oracle=false; started=false;
+                all.clear(); rollback_times.clear(); normal_times.clear(); checkpoint_times.clear(); simulation_times.clear(); cycle_log.clear(); cpu_lateness.clear();
+                fprintf(stderr,"LOOP: reference recorded; starting delayed-input correction verification\n");
+                return running_loop(at);
+            }
+            fprintf(stderr,"PASS: running-loop oracle recorded %u full-state hashes\n",count); fflush(stderr); std::_Exit(0);
+        }
+        require(!std::getenv("BM64_NEGATIVE_INPUT"),"negative control failed to diverge");
+        if(loop_verifying && loop_length) require(prediction_divergences>0,"test did not correct any wrong predictions");
+        if(loop_verifying) {
+            fprintf(stderr,"PASS: running-loop full RAM/register verification; updates=%u rollbacks=%u wrong_predictions_corrected=%u source_retired=%u queue_retired=%llu\n",count,rollbacks,prediction_divergences,source_retired,Probe::retired_presents.load()); fflush(stderr); std::_Exit(0);
+        }
+        // Metal's displayed callback can arrive after present() returns.
+        for(unsigned wait=0;wait<100;++wait) {
+            bool seen=false;
+            { std::lock_guard lock(presentation_mutex); for(auto p:presentations) if(p.frame==count) seen=true; }
+            if(seen) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        { std::lock_guard lock(presentation_mutex);
+          for(auto p:presentations) if(p.frame) fprintf(stderr,"DISPLAY: frame=%llu time_ns=%llu deadline_ns=%llu callback_ns=%llu\n",p.frame,p.time,p.deadline,p.callback);
+          for(auto p:present_traces) if(p.frame) fprintf(stderr,"PRESENT_TRACE: frame=%llu queue_ns=%llu workload_ready_ns=%llu slot_ready_ns=%llu acquired_ns=%llu draw_submitted_ns=%llu draw_done_ns=%llu present_called_ns=%llu\n",p.frame,p.queue,p.workloadReady,p.slotReady,p.acquired,p.drawSubmitted,p.drawDone,p.presentCalled);
+        }
+        distribution("loop_deadline_lateness",cpu_lateness);
+        distribution("loop_cycle",all); distribution("loop_normal",normal_times);
+        if(!rollback_times.empty()) distribution("loop_rollback_plus_normal",rollback_times);
+        distribution("loop_checkpoints",checkpoint_times); distribution("loop_simulation_runtime_residual",simulation_times);
+        profile_report(before,profile(),count-loop_warmup+rollbacks*loop_length);
+        std::map<uint64_t,uint64_t> first;
+        { std::lock_guard lock(presentation_mutex); for(auto p:presentations) if(p.time && (!first.count(p.frame) || p.time<first[p.frame])) first[p.frame]=p.time; }
+        std::vector<double> warm_latency, latency, gaps;
+        for(auto [id,time]:first) {
+            if(!id) continue;
+            require(time<Probe::now()+period,"display clock epoch mismatch");
+            double lag=(time-(epoch+(id-1)*period))/1e6;
+            if(id>loop_warmup/2 && id<=loop_warmup) warm_latency.push_back(lag);
+        }
+        require(warm_latency.size()>=30,"insufficient Metal displayed callbacks");
+        std::sort(warm_latency.begin(),warm_latency.end()); double pipeline_lag=warm_latency[warm_latency.size()/2];
+        unsigned missing=0, late=0, strict_late=0, cpu_late=0, cpu_deadline_misses=0, spikes=0;
+        uint64_t previous=0;
+        for(unsigned i=loop_warmup;i<count;++i) {
+            auto it=first.find(i+1);
+            if(it==first.end()) { ++missing; continue; }
+            double lag=(int64_t(it->second)-int64_t(epoch+i*period))/1e6;
+            latency.push_back(lag); late+=lag>pipeline_lag+1.0; strict_late+=lag>1000.0/60;
+            if(previous) { double gap=(int64_t(it->second)-int64_t(previous))/1e6; gaps.push_back(gap); spikes+=gap>25.0; }
+            previous=it->second;
+        }
+        for(auto c:cycle_log) {
+            double ms=(c.finish-c.wake)/1e6, late=std::max(0.0,(double(c.finish)-double(c.release+period))/1e6);
+            if(c.index>=loop_warmup) { cpu_late+=ms>period/1e6; cpu_deadline_misses+=late>0; }
+            fprintf(stderr,"LOOP_FRAME: index=%u release_ns=%llu wake_ns=%llu execute_ns=%llu finish_ns=%llu work_ms=%.3f execution_ms=%.3f wake_late_ms=%.3f deadline_lateness_ms=%.3f displayed_ns=%llu deadline_ns=%llu capture_ms=%.3f restore_ms=%.3f rollback=%d source_retired=%d\n",c.index,c.release,c.wake,c.execute,c.finish,ms,(c.finish-c.execute)/1e6,(int64_t(c.wake)-int64_t(c.release))/1e6,late,first.count(c.index+1)?first[c.index+1]:0,c.release+period,c.capture,c.restore,c.rollback,c.hidden);
+        }
+        fprintf(stderr,"PRESENT_BOUND: maximum_in_flight=%llu retired=%llu slot_wait_ms=%.3f\n",Probe::maximum_in_flight.load(),Probe::retired_presents.load(),Probe::slot_wait_ns.load()/1e6);
+        fprintf(stderr,"NATIVE_UPLOADS: synchronous_calls=%llu\n",Probe::inline_upload_calls.load());
+        distribution("display_latency",latency); distribution("display_gap",gaps);
+        fprintf(stderr,"LOOP: frames=%u measured=%zu rollback_length=%u rollbacks=%u input_buffer=%u wrong_predictions_corrected=%u CPU_over_budget=%u CPU_deadline_misses=%u displayed_missing=%u strict_display_deadline_misses=%u calibrated_deadline_misses=%u warmup_pipeline_lag_ms=%.3f tolerance_ms=1 display_gaps_over_25ms=%u verification=%s\n",count,all.size(),loop_length,rollbacks,loop_buffer,prediction_divergences,cpu_late,cpu_deadline_misses,missing,strict_late+missing,late+missing,pipeline_lag,spikes,loop_verifying?"full_RAM_and_registers":"disabled");
+        fprintf(stderr,"PASS: running-loop test completed\n"); fflush(stderr); std::_Exit(0);
+    }
+    loop_frontier=frame;
+    uint64_t release=epoch+(frame-at)*period;
+    if(!loop_oracle && !loop_verifying) {
+        loop_wait_until(release);
+    }
+    cycle_release=release; cycle_start=Probe::now();
+    unsigned next_index=frame-at;
+    unsigned hitch_ms=setting("BM64_HITCH_MS",0), hitch_kind=setting("BM64_HITCH_KIND",1);
+    if(!loop_oracle && hitch_ms && next_index>=241 && (next_index-241)%300==0) {
+        if(hitch_kind==1) {
+            auto start=Probe::now();
+            std::this_thread::sleep_for(std::chrono::milliseconds(hitch_ms));
+            fprintf(stderr,"CPU_HITCH: frame=%u start_ns=%llu end_ns=%llu\n",next_index+1,start,Probe::now());
+        } else {
+            require(hitch_kind==2,"unknown hitch kind");
+            Probe::present_hitch_ms=hitch_ms; Probe::present_hitch_frame=next_index+1;
+        }
+    }
+    execution_start=Probe::now(); gfx_before=graphics_wait_ns; cycle_profile=profile(); checkpoint_ms=0; restore_ms=0;
+    presentation_frame=loop_oracle ? 0 : frame-at+1; presentation_deadline=(loop_verifying ? execution_start : release)+period;
+    normal_hidden=!loop_oracle && Probe::bounded_present && execution_start>presentation_deadline;
+    suppress_render=normal_hidden;
+    uint64_t first_late=at+loop_warmup+loop_lead+loop_length;
+    if(!loop_oracle && loop_length && frame>=first_late && (frame-first_late)%loop_spacing==0) {
+        uint64_t wanted=frame-loop_length; auto slot=1+wanted%16;
+        require(snapshots[slot].saved_frame==wanted,"rollback history expired");
+        catchup_active=true; suppress_render=true; replay_pass=1; ++rollbacks;
+        restore_ms=restore(slot,true);
+    }
+    return true;
+}
